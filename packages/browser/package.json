{
  "name": "@allauth/browser",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser SDK for django-allauth Headless API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "latest",
    "esbuild-plugin-alias": "^0.2.1",
    "jsdom": "latest",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "latest"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
