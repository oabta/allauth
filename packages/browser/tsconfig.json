{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2022"],
    "paths": {
      "@/*": ["./src/*"],
      "@/types": ["./src/types.ts"],
      "@/cookies": ["./src/cookies.ts"],
      "@/client": ["./src/client.ts"],
      "@/api": ["./src/api.ts"]
    }
  },
  "include": ["src", "tests"]
}
