{
  "name": "@oabta/allauth",
  "version": "0.1.0",
  "type": "module",
  "description": "SDK for django-allauth Headless API",
  "types": "./dist/index.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./react": {
      "import": "./build/react/index.js",
      "types": "./build/react/index.d.ts"
    },
    "./browser": {
      "import": "./build/browser/index.js",
      "types": "./build/browser/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc-alias",
    "prepare": "npm run build",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "latest",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild-plugin-alias": "^0.2.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "latest",
    "tsc-alias": "^1.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "latest"
  }
}
